ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL=claude-sonnet-5
# Preço por 1 milhão de tokens (verifique em https://claude.com/pricing antes de confiar cegamente — muda com o tempo)
CLAUDE_INPUT_PRICE_PER_MILLION=2
CLAUDE_OUTPUT_PRICE_PER_MILLION=10

GEMINI_API_KEY=xxxxx
GEMINI_MODEL=gemini-3.5-flash-lite
# Preencha com o preço atual em https://ai.google.dev/gemini-api/docs/pricing (varia por modelo)
GEMINI_INPUT_PRICE_PER_MILLION=
GEMINI_OUTPUT_PRICE_PER_MILLION=

# Um ou mais números que podem falar com o bot, separados por vírgula
# (código do país + DDD + número, sem "+", sem espaços).
WHATSAPP_NUMEROS_AUTORIZADOS=5535999999999,5535988888888

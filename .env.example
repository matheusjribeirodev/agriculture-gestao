ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL=claude-sonnet-5
# Preço por 1 milhão de tokens (verifique em https://claude.com/pricing antes de confiar cegamente — muda com o tempo)
CLAUDE_INPUT_PRICE_PER_MILLION=2
CLAUDE_OUTPUT_PRICE_PER_MILLION=10

GEMINI_API_KEY=xxxxx
GEMINI_MODEL=gemini-3.5-flash-lite
# Preencha com o preço atual em https://ai.google.dev/gemini-api/docs/pricing (varia por modelo)
GEMINI_INPUT_PRICE_PER_MILLION=
GEMINI_OUTPUT_PRICE_PER_MILLION=

# Projeto Supabase (Settings -> API). SUPABASE_SERVICE_ROLE_KEY ignora RLS —
# é a chave certa aqui porque isso roda só no backend (nunca no navegador),
# mas nunca deve ser exposta em código client-side nem commitada de verdade.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# Mapa número -> projeto(s) liberado(s), separados por "|" (números) e ","
# (projetos de um mesmo número). Projetos válidos: gestao_rural,
# financas_pessoais. Número fora daqui é barrado.
PERMISSOES_PROJETO=5535999999999:gestao_rural|5535988888888:gestao_rural,financas_pessoais
